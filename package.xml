<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fanuc_pick_drop</name>
  <version>0.1.0</version>
  <description>Billet bin picking (pallet to pallet) for FANUC CRX-10iA/L with Schmalz magnetic EOAT using MoveIt Task Constructor</description>
  <maintainer email="panditsumit888@gmail.com">ntguest</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>moveit_core</depend>
  <depend>geometric_shapes</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_task_constructor_core</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>moveit_configs_utils</exec_depend>
  <!-- Schmalz EOAT xacro -->
  <exec_depend>moveit_resources_fanuc_moveit_config</exec_depend>
  <!-- FANUC official packages (ws_fanuc, built on top of this workspace) -->
  <exec_depend>fanuc_crx_description</exec_depend>
  <exec_depend>fanuc_hardware_interface</exec_depend>
  <exec_depend>fanuc_moveit_config</exec_depend>
  <exec_depend>moveit_task_constructor_capabilities</exec_depend>
  <exec_depend>moveit_task_constructor_visualization</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
